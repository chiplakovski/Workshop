# The server's environment. Copy to /etc/varmak/workshop.env, mode 600, root-owned, and fill it in.
#
# Nothing in this file belongs in the repository. The database password in particular: a password in
# git is a password in every clone, every backup of every clone, and every laptop anybody ever had.

# The database, as the hosted service gives it to you — except for the user, which must be varmak_api.
# The server refuses to start as the owning role, because as the owner every GRANT and every policy in
# auth.sql applies to nobody and nothing would look wrong until a welder read a price.
#
# On Supabase this is the "Session pooler" or the direct connection string from Project Settings →
# Database, with postgres: swapped for varmak_api: and the password replaced with the one you set at
# install time. Any ?sslmode= on the end is ignored: TLS is always on and always verified.
DATABASE_URL=postgresql://varmak_api:CHANGE-ME@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# The certificate authority the database's certificate is signed by, downloaded from the project's own
# dashboard. Leave it unset only if the certificate comes from a public CA — the system trust store is
# used then, and a wrong certificate fails loudly rather than quietly either way.
PGSSLROOTCERT=/etc/varmak/db-ca.crt

# Loopback only, because Caddy is in front. Bound to every interface, the plain-HTTP port would be
# reachable from the network and the certificate in front of it would be decoration.
HOST=127.0.0.1
PORT=8787

# How many database connections this server keeps. Four people and a shop tablet need nothing like the
# default; a hosted database charges for connections and a pooler has a ceiling.
PGPOOL=8
