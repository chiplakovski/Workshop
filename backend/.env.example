# Copy this file to .env and fill in real values for your machine.
# .env itself is gitignored and must never be committed.

# Connection string for the docker-compose Postgres service (see ../docker-compose.yml),
# or any local/temporary PostgreSQL instance (e.g. `npx prisma dev`) during development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workshop?schema=public"
