/// Decision 5 — real, persistent, auditable entity (not derived from BOM gaps at request time).
///
/// Phase 0A-R1: `SUGGESTED` was removed as a persisted state. BOM-shortage suggestions remain
/// purely derived/computed data (e.g. "these BOM lines currently have unmet quantity") and are
/// never written as a PurchaseRequisition row — a real requisition only exists once a user
/// explicitly creates one, starting at `DRAFT`.
///
/// Allowed lifecycle transitions (documented here; enforcement is a Phase 0B service concern,
/// consistent with Phase 0A carrying no business logic):
///   DRAFT      -> SUBMITTED | CANCELLED
///   SUBMITTED  -> APPROVED | REJECTED | CANCELLED
///   APPROVED   -> CONVERTED | CANCELLED
///   CONVERTED, REJECTED, CANCELLED are terminal.
model PurchaseRequisition {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no            String            @unique @db.VarChar(40)
  projectId     String?           @db.Uuid
  status        RequisitionStatus @default(DRAFT)
  requestedById String?           @db.Uuid
  approvedById  String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
  version       Int               @default(0)

  project     Project?                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  requestedBy User?                     @relation("PurchaseRequisitionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?                     @relation("PurchaseRequisitionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines       PurchaseRequisitionLine[]

  @@index([status])
  @@index([projectId])
  @@index([requestedById])
  @@index([approvedById])
}

model PurchaseRequisitionLine {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requisitionId   String   @db.Uuid
  inventoryItemId String   @db.Uuid
  qtyRequested    Decimal  @db.Decimal(12, 3)
  sourceBomLineId String?  @db.Uuid
  purchaseOrderId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  item          InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  sourceBomLine ProjectBomLine?     @relation(fields: [sourceBomLineId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([requisitionId])
  @@index([inventoryItemId])
  @@index([sourceBomLineId])
  @@index([purchaseOrderId])
}

