/// Decision 7/8 — every gate/version event this system must never let go missing or be edited.
/// Phase 0A-R1: `HOURS_ENTRY_CORRECTED` moved to the general AuditLog (action = "hours_entry_corrected")
/// — an hours-entry correction is a business-data change, not a safety-gate decision or piece of
/// protected safety evidence, so it does not belong in this table. See the comment on SafetyEvent
/// for how each remaining kind maps to exactly one typed target (equipmentId / qualityHoldId /
/// qualityReleaseId).
enum SafetyEventKind {
  EQUIPMENT_BLOCK
  EQUIPMENT_PASS
  HOLD_APPLY
  HOLD_RELEASE
  RELEASE_GRANT
  RELEASE_REJECT
  DOCUMENT_SUPERSEDED
}

/// Phase 0A-R1 — no anonymous safety action is allowed: every SafetyEvent has a real User actor
/// (`userId` set, actorType = USER) or an explicit SYSTEM actor representation (`userId` NULL,
/// actorType = SYSTEM, e.g. an automated gate re-evaluation with no human trigger). Enforced by a
/// CHECK constraint added in the migration SQL. SYSTEM is a real, named actor value — never a
/// silently-nullable "unknown".
enum SafetyActorType {
  USER
  SYSTEM
}

/// Decision 2 — Planning/customer reconciliation, and (per §J of the contract) reused for the
/// Decision 9 worker/personnel name-resolution migration addendum.
enum ReconciliationResolution {
  PENDING
  AUTO_MATCHED
  MANUALLY_RESOLVED
  REJECTED
}

// ══════════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS — Decision 4
// ══════════════════════════════════════════════════════════════════════════

/// Phase 0A-R1: `email` is no longer `@unique` in Prisma's declarative sense — Prisma's schema
/// language cannot express a case-insensitive (functional) unique index, and email uniqueness in
/// this system must be case-insensitive (two users cannot register "A@x.com" and "a@x.com" as
/// distinct accounts). The real constraint is `CREATE UNIQUE INDEX ... ON "User" (LOWER(email))`,
/// added directly in the migration SQL; `@@index([email])` below only covers plain lookups.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  fullName     String   @db.VarChar(200)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  userRoles                              UserRole[]
  teamMemberships                        TeamMembership[]
  jobcardWorkerAssignments               JobcardWorker[]
  assignedOperations                     JobcardOperation[]              @relation("OperationAssignedUser")
  supervisorSiteAssignments              SupervisorSiteAssignment[]
  supervisorTeamAssignments              SupervisorTeamAssignment[]
  supervisorProjectAssignments           SupervisorProjectAssignment[]
  supervisorJobcardAssignments           SupervisorJobcardAssignment[]
  hoursEntries                           HoursEntry[]
  uploadedDocuments                      Document[]
  auditLogEntries                        AuditLog[]
  safetyEventEntries                     SafetyEvent[]
  stockMovements                         StockMovement[]
  stockCounts                            StockCount[]
  qualityWelderQuals                     QualityWelderQual[]
  requisitionsRequested                  PurchaseRequisition[]           @relation("PurchaseRequisitionRequestedBy")
  requisitionsApproved                   PurchaseRequisition[]           @relation("PurchaseRequisitionApprovedBy")
  equipmentBreakdownsResolved            EquipmentBreakdown[]
  qualityHoldsApplied                    QualityHold[]                   @relation("QualityHoldAppliedBy")
  qualityHoldsReleased                   QualityHold[]                   @relation("QualityHoldReleasedBy")
  qualityReleasesDecided                 QualityRelease[]
  migrationReconciliationRecordsResolved MigrationReconciliationRecord[]

  @@index([active])
  @@index([email])
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// module.resource.action, e.g. "quality.release.execute" — see contract §G.
  key         String   @unique @db.VarChar(150)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Multiple roles per user (Decision 4).
model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

// ══════════════════════════════════════════════════════════════════════════
// ACCESS SCOPING — Decision 9 (row-level authorization)
// ══════════════════════════════════════════════════════════════════════════

/// "Site represents a physical or operational location." (final product decision)
model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  teams                     Team[]
  projects                  Project[]
  jobcards                  Jobcard[]
  supervisorSiteAssignments SupervisorSiteAssignment[]
}

/// "Every Team has one homeSite." "A Team does not need to change its homeSite to work
/// elsewhere" — cross-site work is represented on Project/Jobcard/Supervisor assignments instead.
model Team {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(200)
  homeSiteId String   @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  homeSite                  Site                       @relation(fields: [homeSiteId], references: [id], onDelete: Restrict)
  memberships               TeamMembership[]
  supervisorTeamAssignments SupervisorTeamAssignment[]

  @@unique([name, homeSiteId])
  @@index([homeSiteId])
}

/// "A User may have multiple TeamMembership records." "TeamMembership supports validFrom,
/// validTo and active status." No uniqueness on (userId, teamId) alone — a user may rejoin a
/// team in a later, non-overlapping period. A partial unique index prevents more than one
/// simultaneously-*active* membership per (user, team) pair — see migration.sql addendum,
/// documented in backend/README.md, since Prisma's schema language cannot express a partial
/// (WHERE-clause) unique index directly.
model TeamMembership {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  teamId    String    @db.Uuid
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([teamId])
  @@index([active])
}

/// Row-scope source for Workshop Supervisor — Decision 9, explicit assignment tables only.
model SupervisorSiteAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  siteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([userId, siteId])
  @@index([siteId])
}

model SupervisorTeamAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  teamId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([userId, teamId])
  @@index([teamId])
}

model SupervisorProjectAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([userId, projectId])
  @@index([projectId])
}

model SupervisorJobcardAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  jobcardId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  jobcard Jobcard @relation(fields: [jobcardId], references: [id], onDelete: Restrict)

  @@unique([userId, jobcardId])
  @@index([jobcardId])
}

// ══════════════════════════════════════════════════════════════════════════
// CRM / SALES
// ══════════════════════════════════════════════════════════════════════════

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no        String   @unique @db.VarChar(40)
  name      String   @db.VarChar(300)
  status    String   @db.VarChar(30)
  org       String?  @db.VarChar(60)
  vat       String?  @db.VarChar(60)
  email     String?  @db.VarChar(254)
  phone     String?  @db.VarChar(60)
  terms     String?  @db.VarChar(100)
  credit    Decimal? @db.Decimal(14, 2)
  currency  String?  @db.Char(3)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  contacts               CustomerContact[]
  estimations            Estimation[]
  invoices               Invoice[]
  projects               Project[]
  marketingLeads         MarketingLead[]
  marketingOpportunities MarketingOpportunity[]
  qualityNcrs            QualityNcr[]
  qualityComplaints      QualityComplaint[]
  documentLinks          DocumentCustomer[]

  @@index([status])
  @@index([name])
}

model CustomerContact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  name       String   @db.VarChar(200)
  role       String?  @db.VarChar(100)
  email      String?  @db.VarChar(254)
  phone      String?  @db.VarChar(60)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
}

model MarketingLead {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              MarketingLeadStatus @default(NEW)
  priority            String?             @db.VarChar(20)
  source              String?             @db.VarChar(40)
  doNotContact        Boolean             @default(false)
  customerId          String?             @db.Uuid
  linkedOpportunityId String?             @unique @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz
  updatedAt           DateTime            @updatedAt @db.Timestamptz

  customer    Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunity MarketingOpportunity? @relation("LeadOpportunity", fields: [linkedOpportunityId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([customerId])
}

model MarketingOpportunity {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stage        MarketingOpportunityStage @default(DISCOVERY)
  probability  Int?
  customerId   String                    @db.Uuid
  estimationId String?                   @unique @db.Uuid
  createdAt    DateTime                  @default(now()) @db.Timestamptz
  updatedAt    DateTime                  @updatedAt @db.Timestamptz
  version      Int                       @default(0)

  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  estimation      Estimation?    @relation(fields: [estimationId], references: [id], onDelete: Restrict)
  originatingLead MarketingLead? @relation("LeadOpportunity")

  @@index([stage])
  @@index([customerId])
}

model MarketingCampaign {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String                  @db.VarChar(200)
  status           MarketingCampaignStatus @default(PLANNED)
  channels         String[]
  targetIndustries String[]
  createdAt        DateTime                @default(now()) @db.Timestamptz
  updatedAt        DateTime                @updatedAt @db.Timestamptz

  @@index([status])
}

// ══════════════════════════════════════════════════════════════════════════
// COMMERCIAL
// ══════════════════════════════════════════════════════════════════════════

model Estimation {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no           String           @unique @db.VarChar(40)
  customerId   String           @db.Uuid
  title        String           @db.VarChar(300)
  status       EstimationStatus @default(DRAFT)
  revision     Int              @default(0)
  totalCost    Decimal          @default(0) @db.Decimal(14, 2)
  sellingPrice Decimal          @default(0) @db.Decimal(14, 2)
  currency     String           @default("SEK") @db.Char(3)
  projectId    String?          @unique @db.Uuid
  createdAt    DateTime         @default(now()) @db.Timestamptz
  updatedAt    DateTime         @updatedAt @db.Timestamptz
  version      Int              @default(0)

  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project     Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  lines       EstimationLine[]
  opportunity MarketingOpportunity?

  @@index([status])
  @@index([customerId])
}

model EstimationLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estimationId String   @db.Uuid
  category     String   @db.VarChar(30)
  description  String   @db.VarChar(500)
  qty          Decimal  @db.Decimal(12, 3)
  unitCost     Decimal  @db.Decimal(14, 4)
  unitSell     Decimal  @db.Decimal(14, 4)
  discountPct  Decimal  @default(0) @db.Decimal(5, 2)
  taxPct       Decimal  @default(0) @db.Decimal(5, 2)
  wastePct     Decimal  @default(0) @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  estimation Estimation @relation(fields: [estimationId], references: [id], onDelete: Restrict)

  @@index([estimationId])
}

/// Customer-facing invoice. Named `Invoice` to match the contract's entity inventory
/// (distinct from SupplierInvoice, the payable-side entity under Procurement below).
model Invoice {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no         String                @unique @db.VarChar(40)
  customerId String                @db.Uuid
  status     CustomerInvoiceStatus @default(DRAFT)
  value      Decimal               @db.Decimal(14, 2)
  currency   String                @default("SEK") @db.Char(3)
  dueDate    DateTime?             @db.Date
  archived   Boolean               @default(false)
  createdAt  DateTime              @default(now()) @db.Timestamptz
  updatedAt  DateTime              @updatedAt @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([customerId])
}

