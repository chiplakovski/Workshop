/// Decision 7 (server-side gate authority) + Decision 8 (immutable supersession). `blockingReasons`
/// and `gateResultSnapshot` are always server-computed by the Phase 0B ReleaseGateService — no
/// field here is ever client-writable in the future API; Phase 0A does not implement that service.
///
/// Phase 0A-R1: QualityRelease represents immutable safety evidence in the same sense as
/// SafetyEvent and Document. It is enforced insert-only at the database level (the same
/// BEFORE UPDATE/DELETE trigger pattern as SafetyEvent, added in the migration SQL) — an existing
/// release row can never be edited or deleted. A correction, replacement or revocation creates a
/// new QualityRelease row whose `previousVersionId` points at the one it supersedes (identical
/// self-referential version-chain pattern to Document.previousVersionId, including the same
/// one-hop self-reference CHECK constraint; full multi-hop cycle prevention is, likewise, deferred
/// to application-level validation and tests). `version` (optimistic-concurrency) is removed:
/// an immutable row is never concurrently updated, so there is nothing for it to protect. There is
/// deliberately no `supersededAt` here either (Phase 0A-R1 review-correction): an immutable,
/// insert-only row can never later be UPDATEd to record when it was superseded — that fact is
/// carried entirely by the *new* row's own `previousVersionId` and `createdAt`/`decidedAt`.
///
/// Phase 0A-R1 review-correction: every result — including RELEASED and RELEASED_WITH_CONDITIONS,
/// not just NOT_RELEASED — now carries full decision-level attribution: `decisionActorType`
/// (required) with the same USER-requires-actor / SYSTEM-forbids-actor CHECK used by SafetyEvent
/// and QualityHold; `decidedAt` (required, not nullable); `gateVersion` (required, non-blank,
/// CHECK-enforced); `gateResultSnapshot` (required — plain NOT NULL alone is not sufficient, see
/// below); `blockingReasons` (required JSON, defaulting to `[]` when there are none — never NULL,
/// so "no reasons" and "reasons not recorded" cannot be confused). `RELEASED_WITH_CONDITIONS`
/// carrying actual conditions is a content-shape rule on an arbitrary JSON blob — deliberately
/// left to the future ReleaseGateService rather than a brittle SQL check, per instruction.
///
/// Phase 0A-R1 final integrity pass, two further gaps closed:
///
/// 1. PostgreSQL's `NOT NULL` accepts JSONB `null` (the JSON value, not the SQL NULL) — a row
///    could satisfy every NOT NULL constraint while still carrying no real evidence at all. CHECK
///    constraints added in the migration SQL now require `jsonb_typeof(gateResultSnapshot) =
///    'object'` and `jsonb_typeof(blockingReasons) = 'array'`, which reject both JSON `null` and
///    any wrong type in one check (`jsonb_typeof('null'::jsonb)` is the *string* `'null'`, never
///    `'object'`/`'array'`) — an empty array is fine, a `null` or an array-instead-of-object is
///    not.
/// 2. `previousVersionId` only guaranteed the chain doesn't reference itself — it never checked
///    that the release being superseded actually belongs to the same Project/Jobcard. A
///    `BEFORE INSERT` trigger (`quality_release_supersession_context_check()` — this needs a
///    cross-row lookup a plain CHECK constraint cannot perform) now rejects any new release whose
///    `previousVersionId` points at a release with a different `projectId`, or a `jobcardId` that
///    doesn't match exactly (including NULL-vs-NULL) — a QualityRelease can never be superseded
///    across Project or Jobcard boundaries.
model QualityRelease {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no                 String             @unique @db.VarChar(40)
  projectId          String             @db.Uuid
  jobcardId          String?            @db.Uuid
  result             FinalReleaseResult
  decisionActorType  SafetyActorType
  decidedById        String?            @db.Uuid
  decidedAt          DateTime           @db.Timestamptz
  gateVersion        String             @db.VarChar(40)
  gateResultSnapshot Json
  blockingReasons    Json               @default("[]")
  previousVersionId  String?            @unique @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz

  project         Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobcard         Jobcard?               @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  decidedBy       User?                  @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  previousVersion QualityRelease?        @relation("QualityReleaseVersionChain", fields: [previousVersionId], references: [id], onDelete: Restrict)
  supersededBy    QualityRelease?        @relation("QualityReleaseVersionChain")
  documentLinks   FinalReleaseDocument[]
  safetyEvents    SafetyEvent[]

  @@index([result])
  @@index([projectId])
  @@index([jobcardId])
  @@index([decidedById])
}

