model JobcardOperation {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobcardId      String                 @db.Uuid
  sequence       Int
  description    String                 @db.VarChar(500)
  status         JobcardOperationStatus @default(PENDING)
  plannedHours   Decimal                @default(0) @db.Decimal(10, 2)
  loggedHours    Decimal                @default(0) @db.Decimal(10, 2)
  dependencyId   String?                @db.Uuid
  equipmentId    String?                @db.Uuid
  assignedUserId String?                @db.Uuid
  createdAt      DateTime               @default(now()) @db.Timestamptz
  updatedAt      DateTime               @updatedAt @db.Timestamptz
  version        Int                    @default(0)

  jobcard      Jobcard            @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  dependency   JobcardOperation?  @relation("OperationDependency", fields: [dependencyId], references: [id], onDelete: Restrict)
  dependents   JobcardOperation[] @relation("OperationDependency")
  equipment    Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  assignedUser User?              @relation("OperationAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
