/// Phase 0A-R1: `capaId` here is the single authoritative NCR-CAPA link — "this NCR is
/// remediated by this CAPA." The prior reverse-direction QualityCapa.ncrId column (an
/// independently-settable "this CAPA originated from this NCR" pointer) was removed: the two
/// could disagree (NCR#1.capaId = CAPA#5 while CAPA#5.ncrId = NCR#2), since nothing enforced
/// them to agree. A CAPA's originating/linked NCRs are now purely the reverse of this one
/// column (QualityCapa.ncrsLinkedToThisCapa) — one CAPA can remediate zero, one, or many NCRs,
/// and there is exactly one place in the schema where that fact is recorded, so it cannot
/// contradict itself.
model QualityNcr {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no          String          @unique @db.VarChar(40)
  title       String          @db.VarChar(300)
  projectId   String?         @db.Uuid
  jobcardId   String?         @db.Uuid
  supplierId  String?         @db.Uuid
  customerId  String?         @db.Uuid
  capaId      String?         @db.Uuid
  category    NcrCategory
  severity    NcrSeverity
  status      NcrStatus       @default(DRAFT)
  disposition NcrDisposition?
  createdAt   DateTime        @default(now()) @db.Timestamptz
  updatedAt   DateTime        @updatedAt @db.Timestamptz
  version     Int             @default(0)

  project       Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobcard       Jobcard?           @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  customer      Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  capa          QualityCapa?       @relation(fields: [capaId], references: [id], onDelete: Restrict)
  holds         QualityHold[]
  complaints    QualityComplaint[]
  documentLinks NcrDocument[]

  @@index([status])
  @@index([severity])
  @@index([projectId])
  @@index([jobcardId])
  @@index([supplierId])
  @@index([customerId])
  @@index([capaId])
}

model QualityCapa {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no        String     @unique @db.VarChar(40)
  status    CapaStatus @default(OPEN)
  fiveWhys  String[]
  fishbone  Json?
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @db.Timestamptz

  /// Purely the reverse of QualityNcr.capaId — see the comment on QualityNcr. Not a second
  /// source of truth: this array has no field of its own, it is just every QualityNcr row
  /// whose capaId points here.
  ncrsLinkedToThisCapa QualityNcr[]

  @@index([status])
}

/// Phase 0A-R1: target-scope integrity is enforced by a CHECK constraint added in the migration
/// SQL (Prisma's schema language has no `@@check` attribute — confirmed against 7.10.0): PROJECT
/// scope requires projectId and forbids jobcardId; JOBCARD scope requires jobcardId and forbids
/// projectId. A hold can never exist without a valid target.
///
/// Phase 0A-R1 review-correction: apply and release each carry their own actor-type/actor pair —
/// `appliedActorType`/`appliedById` (required: every hold must record who or what applied it) and
/// `releasedActorType`/`releasedById` (nullable until released), each with the same USER-requires-
/// actor / SYSTEM-forbids-actor CHECK as SafetyEvent. A further CHECK constraint, added in
/// the migration SQL, keeps the release-fact fields internally consistent with `status`: an ACTIVE
/// row must have every release field NULL; a RELEASED row must have every release field populated
/// (actor type, actor consistency, releasedAt, and non-blank releaseReason/releaseEvidenceRef) —
/// this applies to every INSERT as much as every UPDATE, so a row can never be inserted directly
/// as RELEASED with incomplete release facts either.
///
/// Phase 0A-R1 final integrity pass: `quality_hold_immutability()` (the migration-SQL trigger
/// backing all of this) was widened from "lock the release fact once RELEASED" to full identity
/// and lifecycle immutability, because the narrower version still let `no`, `scope`, `projectId`,
/// `jobcardId`, `ncrId`, `appliedActorType`, `appliedById`, `appliedAt` and `createdAt` change
/// freely at any time — an existing safety hold could be silently retargeted to a different
/// Project/Jobcard or made to claim a different applying actor. Now: those nine columns can never
/// change after INSERT, under any circumstance; while ACTIVE, the only permitted change to the
/// row is the complete ACTIVE -> RELEASED transition (plus the always-free technical `updatedAt`/
/// `version` fields); and once `status` is RELEASED, the trigger rejects *every* UPDATE to the
/// row outright — full stop, the same terminal immutability as SafetyEvent/QualityRelease/
/// AuditLog, just reached via one legitimate prior UPDATE instead of being insert-only from
/// creation. The full historical trail of apply/release actions is additionally recorded,
/// unconditionally immutably, in SafetyEvent (kind HOLD_APPLY / HOLD_RELEASE).
model QualityHold {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  no                 String            @unique @db.VarChar(40)
  scope              QualityHoldScope
  projectId          String?           @db.Uuid
  jobcardId          String?           @db.Uuid
  ncrId              String?           @db.Uuid
  status             QualityHoldStatus @default(ACTIVE)
  appliedActorType   SafetyActorType
  appliedById        String?           @db.Uuid
  appliedAt          DateTime          @db.Timestamptz
  releasedActorType  SafetyActorType?
  releasedById       String?           @db.Uuid
  releasedAt         DateTime?         @db.Timestamptz
  releaseReason      String?           @db.VarChar(1000)
  releaseEvidenceRef String?           @db.VarChar(500)
  createdAt          DateTime          @default(now()) @db.Timestamptz
  updatedAt          DateTime          @updatedAt @db.Timestamptz
  version            Int               @default(0)

  project       Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jobcard       Jobcard?              @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  ncr           QualityNcr?           @relation(fields: [ncrId], references: [id], onDelete: Restrict)
  appliedBy     User?                 @relation("QualityHoldAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  releasedBy    User?                 @relation("QualityHoldReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  documentLinks QualityHoldDocument[]
  safetyEvents  SafetyEvent[]

  @@index([status])
  @@index([scope])
  @@index([projectId])
  @@index([jobcardId])
  @@index([ncrId])
  @@index([appliedById])
  @@index([releasedById])
}

