  @@unique([jobcardId, sequence])
  @@index([status])
  @@index([equipmentId])
  @@index([assignedUserId])
  @@index([dependencyId])
}

/// Row-scope source for Workshop Worker — Decision 9. Replaces the frontend's free-text
/// `workers[]` array with a real many-to-many relation.
model JobcardWorker {
  jobcardId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  jobcard Jobcard @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([jobcardId, userId])
  @@index([userId])
}

model HoursEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobcardId   String   @db.Uuid
  operationId String?  @db.Uuid
  userId      String   @db.Uuid
  hours       Decimal  @db.Decimal(8, 2)
  workDate    DateTime @db.Date
  billable    Boolean?
  overtime    Boolean?
  notes       String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  jobcard   Jobcard           @relation(fields: [jobcardId], references: [id], onDelete: Restrict)
  operation JobcardOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([jobcardId])
  @@index([operationId])
  @@index([userId])
  @@index([workDate])
}

/// Decision 3 — legacy per-jobcard inspection checklist, migrated in as read-only history only.
/// No create/update path is exposed for this model past migration; QualityInspection is the
/// sole authoritative inspection system going forward.
model JobcardInspectionLegacy {
