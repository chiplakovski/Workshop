// DOCUMENTS — Decision 1 (real FK relation tables, no polymorphic soft-link)
//             + Decision 8 (named quality/safety relation models, immutable supersession)
// ══════════════════════════════════════════════════════════════════════════

/// `previousVersionId` implements Decision 8's immutable-supersession chain: a safety-linked
/// document is never hard-deleted, only replaced by inserting a new Document row that points
/// back at the one it supersedes. The self-referential FK's simple self-reference case
/// (id != previousVersionId) is enforced by a CHECK constraint added in the migration SQL
/// (Prisma's schema language has no `@check` attribute); full multi-hop cycle prevention
/// (A -> B -> A across more than one hop) is NOT expressible as a plain SQL constraint and is
/// explicitly deferred to application-level validation and tests, per the contract's own
/// instruction ("cycle prevention handled by validation and tests") — see backend/README.md.
model Document {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String         @db.VarChar(300)
  type              DocumentType   @default(DOCUMENT)
  category          String?        @db.VarChar(100)
  status            DocumentStatus @default(DRAFT)
  storageKey        String?        @unique @db.VarChar(500)
  mimeType          String?        @db.VarChar(150)
  fileSize          BigInt?
  checksum          String?        @db.VarChar(128)
  uploadedById      String?        @db.Uuid
  previousVersionId String?        @unique @db.Uuid
  supersededAt      DateTime?      @db.Timestamptz
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz
  version           Int            @default(0)

  uploadedBy      User?     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  previousVersion Document? @relation("DocumentVersionChain", fields: [previousVersionId], references: [id], onDelete: Restrict)
  supersededBy    Document? @relation("DocumentVersionChain")

  customerLinks            DocumentCustomer[]
  supplierLinks            DocumentSupplier[]
  projectLinks             DocumentProject[]
  jobcardLinks             DocumentJobcard[]
  equipmentLinks           DocumentEquipment[]
  purchaseOrderLinks       DocumentPurchaseOrder[]
  qualityInspectionLinks   QualityInspectionDocument[]
  ncrLinks                 NcrDocument[]
  qualityHoldLinks         QualityHoldDocument[]
  wpsLinks                 WpsDocument[]
  welderQualificationLinks WelderQualificationDocument[]
  ndtRecordLinks           NdtRecordDocument[]
  finalReleaseLinks        FinalReleaseDocument[]
  inventoryLotLinks        InventoryLotDocument[]
  safetyEventsAsPrevious   SafetyEvent[]                 @relation("SafetyEventPreviousDocument")
  safetyEventsAsNew        SafetyEvent[]                 @relation("SafetyEventNewDocument")

  @@index([status])
  @@index([type])
  @@index([uploadedById])
}

