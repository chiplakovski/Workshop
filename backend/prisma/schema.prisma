/// General business changelog — the Quality shape from the original audit (§4/§H of the
/// contract), the richest of the three legacy shapes, used as the one canonical audit table.
///
/// `entityType` is a label used only for filtering/display; it never drives a join or a
/// write-time authorization decision, and no code path treats (entityType, entityId) as a
/// trusted foreign key. This is the one explicitly-justified exception to the "no polymorphic
/// entityType/entityId soft link" rule, carried over verbatim from the approved contract (§D) —
/// every *load-bearing* relationship in this schema (Documents included) uses a real FK.
///
/// `entityId` is a plain VarChar, not @db.Uuid: not every loggable entity has a UUID primary
/// key (e.g. InventoryItem.code, BarcodeLink.barcode are human-assigned VarChar identifiers),
/// and this column must be able to hold either.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz
  entityType String   @db.VarChar(60)
  entityId   String   @db.VarChar(100)
  action     String   @db.VarChar(200)
  fromValue  String?  @db.VarChar(500)
  toValue    String?  @db.VarChar(500)
  reference  String?  @db.VarChar(200)
  reason     String?  @db.VarChar(1000)
  userId     String?  @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([userId])
}

/// Decision 7/8/9 — append-only. PostgreSQL-level protection (a trigger rejecting UPDATE/DELETE)
/// is added in the migration SQL, since Prisma's schema language has no attribute for this —
/// see backend/README.md for exactly what is and is not enforced at the database level.
///
/// Phase 0A-R1: the prior `entityType`/`entityId` polymorphic soft link — unverified at the
/// database level, unlike AuditLog.entityType which is explicitly documented and accepted as a
/// label-only exception — is removed. Every SafetyEvent now targets exactly one real, typed,
/// indexed foreign key (or, for DOCUMENT_SUPERSEDED, a typed pair), enforced by a CHECK
/// constraint added in the migration SQL:
///   - EQUIPMENT_BLOCK / EQUIPMENT_PASS  -> equipmentId only
///   - HOLD_APPLY / HOLD_RELEASE         -> qualityHoldId only
///   - RELEASE_GRANT / RELEASE_REJECT    -> qualityReleaseId only
///   - DOCUMENT_SUPERSEDED               -> previousDocumentId AND newDocumentId, both set,
///                                          both required to differ from each other, and every
///                                          other target column NULL
/// `reasons`, `gateVersion` and `decisionSnapshot` record the gate decision itself: the reason
/// code(s), which version of the gate/rule logic produced the decision, and a snapshot of the
/// inputs the decision was based on — all for later audit, since Phase 0B's gate services are not
/// implemented yet and their exact output shape isn't finalized.
///
/// Phase 0A-R1 review-correction: `reasons` and `decisionSnapshot` are now required — a
/// successful gate decision may record an empty `reasons` array (`@default("[]")`; "no blocking
/// reasons" and "reasons not recorded" must never be confused as the same NULL), but
/// `decisionSnapshot` has no such empty-case default: every event, success or failure, records
/// what it was based on. DOCUMENT_SUPERSEDED previously identified only the QualityHold/
/// QualityRelease context a document supersession happened in, without naming the two actual
/// Document rows involved — `previousDocumentId`/`newDocumentId` (real FKs to Document) fix that;
/// this kind no longer uses qualityHoldId/qualityReleaseId/equipmentId at all.
///
/// Phase 0A-R1 final integrity pass, two further gaps closed:
///
/// 1. `gateVersion` gained the same non-blank CHECK QualityRelease already had
///    (`SafetyEvent_gateVersion_normalized` — this was an oversight in the prior pass, present on
///    QualityRelease but not here). `reasons`/`decisionSnapshot` gained the same JSON-shape CHECKs
///    as QualityRelease's `blockingReasons`/`gateResultSnapshot`
///    (`jsonb_typeof(reasons) = 'array'`, `jsonb_typeof(decisionSnapshot) = 'object'`) — plain
///    `NOT NULL` accepts JSONB `null`, which is not valid evidence; these reject both JSON `null`
///    and any wrong type.
/// 2. The exactly-one-target CHECK only verified that `previousDocumentId`/`newDocumentId` were
///    two different, real `Document` rows — it never verified the new document actually
///    supersedes the stated previous one. A `BEFORE INSERT` trigger
///    (`safety_event_document_supersession_check()` — a cross-row lookup a plain CHECK cannot
///    perform) now rejects any `DOCUMENT_SUPERSEDED` event where
///    `newDocument.previousVersionId <> previousDocumentId`: the event can no longer claim a
///    supersession that the Document version chain itself does not agree with.
model SafetyEvent {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt         DateTime        @default(now()) @db.Timestamptz
  kind               SafetyEventKind
  equipmentId        String?         @db.Uuid
  qualityHoldId      String?         @db.Uuid
  qualityReleaseId   String?         @db.Uuid
  previousDocumentId String?         @db.Uuid
  newDocumentId      String?         @db.Uuid
  reasons            Json            @default("[]")
  gateVersion        String          @db.VarChar(40)
  decisionSnapshot   Json
  actorType          SafetyActorType
  userId             String?         @db.Uuid

  equipment        Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  qualityHold      QualityHold?    @relation(fields: [qualityHoldId], references: [id], onDelete: Restrict)
  qualityRelease   QualityRelease? @relation(fields: [qualityReleaseId], references: [id], onDelete: Restrict)
  previousDocument Document?       @relation("SafetyEventPreviousDocument", fields: [previousDocumentId], references: [id], onDelete: Restrict)
  newDocument      Document?       @relation("SafetyEventNewDocument", fields: [newDocumentId], references: [id], onDelete: Restrict)
  user             User?           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([kind])
  @@index([equipmentId])
  @@index([qualityHoldId])
  @@index([qualityReleaseId])
  @@index([previousDocumentId])
  @@index([newDocumentId])
  @@index([occurredAt])
  @@index([userId])
}

/// Decision 2 (Planning/customer collisions) and its Decision 9 addendum (worker/personnel
/// name resolution) both use this one mechanism: auto-migrate only deterministic matches,
/// write everything else here for a human to resolve, never silently merge.
model MigrationReconciliationRecord {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceCollection String                   @db.VarChar(100)
  sourceKey        String                   @db.VarChar(300)
  candidateMatches Json?
  resolution       ReconciliationResolution @default(PENDING)
  resolvedById     String?                  @db.Uuid
  resolvedAt       DateTime?                @db.Timestamptz
  createdAt        DateTime                 @default(now()) @db.Timestamptz

  resolvedBy User? @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([resolution])
  @@index([sourceCollection])
  @@index([resolvedById])
}
